/*basic reset */
*{
    margin:0;
    padding: 0;
    box-sizing: border-box:
}
body{
    font-family:arial, sans-serif;
    color:#333;
    line-height: 1.6;
}

/* Navigation */
nav ul {
    list-style:none;
    display:flex;
    justify-content:center;
    gap:2rem;
    background:#2c3e50;
    padding:1rem;
}
nav a{
    color:white;
    text-decoration: none;
}
/*Hero */
.hero {
    text align:center;
    padding:3rem 1rem;
}
.hero img {
    widh:180px
}